+int32_t Af::fromLensPosition(float lensPosition) const
+{
+	const float f = std::clamp(lensPosition, 0.0f, kLensPositionMax) / kLensPositionMax;
+	return farPosition_ + static_cast<int32_t>(f * (macroPosition_ - farPosition_));
+}
+
+float Af::toLensPosition(int32_t position) const
+{
+	if (macroPosition_ == farPosition_)
+		return 0.0f;
+
+	const float f = static_cast<float>(position - farPosition_) /
+			(macroPosition_ - farPosition_);
+	return std::clamp(f, 0.0f, 1.0f) * kLensPositionMax;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.configuration.af.available)
+		return;
+
+	const auto &afMode = controls.get(controls::AfMode);
+	if (afMode) {
+		Mode mode = Mode::Continuous;
+		if (*afMode == controls::AfModeManual)
+			mode = Mode::Manual;
+		else if (*afMode == controls::AfModeAuto)
+			mode = Mode::Auto;
+
+		if (mode != mode_) {
+			LOG(IPASoftAf, Debug) << "Mode " << *afMode;
+			mode_ = mode;
+
+			/*
+			 * Applications may send the trigger just before they
+			 * switch to the auto mode: a trigger that is still held
+			 * counts for the new mode.
+			 */
+			if (mode_ == Mode::Continuous) {
+				held_ = false;
+				startSearch(context, position_);
+			} else if (mode_ == Mode::Auto && held_) {
+				startSearch(context, position_);
+			} else {
+				held_ = false;
+				state_ = State::Idle;
+			}
+		}
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && mode_ == Mode::Manual) {
+		const int32_t position = fromLensPosition(*lensPosition);
+		if (position != position_)
+			moveTo(context, position);
+	}
+
+	const auto &afTrigger = controls.get(controls::AfTrigger);
+	if (!afTrigger || mode_ == Mode::Manual)
+		return;
+
+	LOG(IPASoftAf, Debug)
+		<< "Trigger " << *afTrigger << (held_ ? ", focus held" : "");
+
+	if (*afTrigger == controls::AfTriggerStart) {
+		/* Hold the focus once it is found, until the trigger is cancelled. */
+		if (!held_ && mode_ == Mode::Auto)
+			startSearch(context, position_);
+		held_ = true;
+	} else if (*afTrigger == controls::AfTriggerCancel) {
+		held_ = false;
+		if (mode_ == Mode::Auto)
+			state_ = State::Idle;
+	}
+}
