+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast based continuous autofocus
+ */
+
+#pragma once
+
+#include <optional>
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Search,
+		Locked,
+	};
+
+	double contrast(const SwIspStats *stats) const;
+	bool inRange(int32_t position) const;
+	void moveTo(IPAContext &context, int32_t position);
+	void startSearch(IPAContext &context, int32_t position);
+	void search(IPAContext &context, double value);
+	void monitor(IPAContext &context, double value);
+
+	/* Tuning parameters */
+	int32_t coarseStep_;
+	int32_t fineStep_;
+	int32_t startPosition_;
+	int32_t maxPosition_;
+	unsigned int settle_;
+	double improve_;
+	double rescan_;
+	unsigned int rescanCount_;
+
+	/* Lens range */
+	int32_t min_;
+	int32_t max_;
+
+	State state_;
+	int32_t position_;
+	int32_t bestPosition_;
+	int32_t step_;
+	int direction_;
+	bool advanced_;
+	bool reversed_;
+	bool lockPending_;
+	double best_;
+	double locked_;
+	unsigned int wait_;
+	unsigned int changed_;
+
+	/* Where the last search ended, kept from one session to the next. */
+	std::optional<int32_t> lastLocked_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
