+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast based continuous autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+/**
+ * \file af.h
+ * \brief Contrast based continuous autofocus for the software ISP
+ *
+ * The statistics carry the sum of the squared luminance differences between
+ * neighbouring samples in the centre of the picture. It is highest when the
+ * picture is in focus. The algorithm climbs that hill: it moves the lens in one
+ * direction as long as the contrast improves, comes back to the best position
+ * when it drops, halves the step and repeats in both directions until the step
+ * is small. It then keeps the lens where it is until the contrast has changed
+ * considerably for some time, which means that the scene is another one.
+ *
+ * The lens only settles, and the statistics only arrive, every few frames, so
+ * a search takes a few seconds.
+ */
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	coarseStep_ = tuningData["coarseStep"].get<int32_t>(48);
+	fineStep_ = tuningData["fineStep"].get<int32_t>(6);
+	startPosition_ = tuningData["startPosition"].get<int32_t>(120);
+	maxPosition_ = tuningData["maxPosition"].get<int32_t>(0);
+	settle_ = tuningData["settle"].get<uint32_t>(1);
+	improve_ = tuningData["improve"].get<double>(1.02);
+	rescan_ = tuningData["rescan"].get<double>(1.5);
+	rescanCount_ = tuningData["rescanCount"].get<uint32_t>(4);
+
+	coarseStep_ = std::max(coarseStep_, 1);
+	fineStep_ = std::clamp(fineStep_, 1, coarseStep_);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	if (!context.configuration.af.available)
+		return 0;
+
+	min_ = context.configuration.af.min;
+	max_ = context.configuration.af.max;
+	if (maxPosition_ > min_)
+		max_ = std::min(max_, maxPosition_);
+
+	/* The camera is most likely pointed at the same kind of scene again. */
+	const int32_t start = lastLocked_.value_or(startPosition_);
+
+	LOG(IPASoftAf, Info)
+		<< "Lens positions " << min_ << "-" << max_
+		<< ", starting at " << start;
+
+	startSearch(context, start);
+
+	return 0;
+}
+
+/* Contrast, made independent of the exposure with the mean luminance. */
+double Af::contrast(const SwIspStats *stats) const
+{
+	uint64_t count = 0;
+	uint64_t sum = 0;
+
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+		count += stats->yHistogram[i];
+		sum += stats->yHistogram[i] * (2 * i + 1);
+	}
+
+	if (!count)
+		return 0.0;
+
+	const double mean = sum * (256.0 / SwIspStats::kYHistogramSize / 2) / count;
+
+	return stats->sharpness / (mean * mean + 64.0);
+}
+
+bool Af::inRange(int32_t position) const
+{
+	return position >= min_ && position <= max_;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, min_, max_);
+	context.activeState.af.position = position_;
+	/* Let the lens settle and the pictures taken before go by. */
+	wait_ = settle_;
+}
+
+void Af::startSearch(IPAContext &context, int32_t position)
+{
+	state_ = State::Search;
+	step_ = coarseStep_;
+	direction_ = 1;
+	advanced_ = false;
+	reversed_ = false;
+	best_ = -1.0;
+	changed_ = 0;
+
+	moveTo(context, position);
+}
+
+void Af::search(IPAContext &context, double value)
+{
+	if (best_ < 0.0) {
+		/* The first measurement, at the start position. */
+		best_ = value;
+		bestPosition_ = position_;
+		if (!inRange(position_ + direction_ * step_))
+			direction_ = -direction_;
+		moveTo(context, position_ + direction_ * step_);
+		return;
+	}
+
+	if (value > best_ * improve_) {
+		best_ = value;
+		bestPosition_ = position_;
+		advanced_ = true;
+
+		if (inRange(position_ + direction_ * step_)) {
+			moveTo(context, position_ + direction_ * step_);
+			return;
+		}
+	}
+
+	/*
+	 * No improvement, or the end of the range. If not even the first step
+	 * in this direction was one, try the other direction.
+	 */
+	if (!advanced_ && !reversed_) {
+		reversed_ = true;
+		direction_ = -direction_;
+		if (inRange(bestPosition_ + direction_ * step_)) {
+			moveTo(context, bestPosition_ + direction_ * step_);
+			return;
+		}
+	}
+
+	/* The best position is bracketed: look closer, or stop. */
+	step_ /= 2;
+	if (step_ < fineStep_) {
+		LOG(IPASoftAf, Debug)
+			<< "Locked at " << bestPosition_ << ", contrast " << best_;
+		state_ = State::Locked;
+		lockPending_ = true;
+		lastLocked_ = bestPosition_;
+		moveTo(context, bestPosition_);
+		return;
+	}
+
+	advanced_ = false;
+	reversed_ = false;
+	direction_ = -direction_;
+	if (!inRange(bestPosition_ + direction_ * step_))
+		direction_ = -direction_;
+	moveTo(context, bestPosition_ + direction_ * step_);
+}
+
+void Af::monitor(IPAContext &context, double value)
+{
+	if (lockPending_) {
+		locked_ = value;
+		lockPending_ = false;
+		changed_ = 0;
+		return;
+	}
+
+	if (value > locked_ * rescan_ || value * rescan_ < locked_) {
+		changed_++;
+	} else {
+		/* Follow slow changes, of the light for example. */
+		locked_ = 0.8 * locked_ + 0.2 * value;
+		changed_ = 0;
+	}
+
+	if (changed_ < rescanCount_)
+		return;
+
+	LOG(IPASoftAf, Debug)
+		<< "Contrast went from " << locked_ << " to " << value
+		<< ", searching again";
+	startSearch(context, position_);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	if (!context.configuration.af.available || !stats->valid)
+		return;
+
+	if (wait_) {
+		wait_--;
+		return;
+	}
+
+	const double value = contrast(stats);
+
+	LOG(IPASoftAf, Debug)
+		<< "position " << position_ << " contrast " << value;
+
+	if (state_ == State::Search)
+		search(context, value);
+	else
+		monitor(context, value);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
