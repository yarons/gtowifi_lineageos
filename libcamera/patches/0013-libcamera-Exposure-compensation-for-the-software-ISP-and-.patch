 static constexpr float kExpMaxStep = 0.15;
 
+/*
+ * Exposure compensation. The mean sample value is not proportional to the
+ * exposure, so an exposure value is no exact photographic stop here: it moves
+ * the target of the regulation, by an amount that keeps the target inside the
+ * range where the regulation works.
+ */
+static constexpr float kExposureValueMax = 2.0;
+static constexpr float kExposureValueStep = 0.6;
+
 Agc::Agc()
 {
 }
 
+int Agc::init(IPAContext &context,
+	      [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::ExposureValue] =
+		ControlInfo(-kExposureValueMax, kExposureValueMax, 0.0f);
+
+	return 0;
+}
+
+void Agc::queueRequest([[maybe_unused]] IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	const auto &exposureValue = controls.get(controls::ExposureValue);
+	if (exposureValue)
+		exposureValue_ = std::clamp(*exposureValue, -kExposureValueMax,
+					    kExposureValueMax);
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 
-	double error = kExposureOptimal - exposureMSV;
+	double error = kExposureOptimal + exposureValue_ * kExposureValueStep -
+		       exposureMSV;
 
 	if (std::abs(error) <= kExposureSatisfactory)
 		return;
