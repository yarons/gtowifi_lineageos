From: Yaron Shahrabani <yarons@users.noreply.github.com>
Subject: [PATCH] android: Serve several YUV streams from a single camera stream

The software ISP of the simple pipeline handler produces one processed
stream, Android applications ask for a preview stream plus a JPEG stream
("Unsupported number of output streams: 2"). Capture the largest NV12 stream
only and scale the smaller ones down from it with the YUV post-processor,
which already supports that:

- configureStreams() maps the smaller NV12 streams onto the largest one, and
  an Internal stream (the NV12 source of a JPEG stream) may be the source of
  Mapped streams.
- CameraStream::process() describes the destination buffer of a YUV stream
  with the size of the Android stream instead of the size of its source.
- The generic frame buffer allocator uses anonymous memory instead of the
  legacy gralloc module, which does not exist (or has no YUV formats) on
  devices with a current gralloc. The buffers are only accessed by the CPU.
---
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -705,6 +705,43 @@
 	}
 
 	sortCamera3StreamConfigs(streamConfigs, jpegStream);
+
+	/*
+	 * A camera that produces a single processed stream (the simple pipeline
+	 * handler with the software ISP) can't serve several NV12 streams.
+	 * Capture only the largest NV12 stream, which
+	 * sortCamera3StreamConfigs() has put first, and let the YUV
+	 * post-processor scale the smaller ones down from it.
+	 */
+	if (streamConfigs.size() > 1 &&
+	    streamConfigs[0].config.pixelFormat == formats::NV12) {
+		Camera3StreamConfig &largest = streamConfigs[0];
+
+		for (auto it = streamConfigs.begin() + 1; it != streamConfigs.end();) {
+			bool yuvOnly = it->config.pixelFormat == formats::NV12 &&
+				       std::all_of(it->streams.begin(), it->streams.end(),
+						   [](const Camera3StreamConfig::Camera3Stream &s) {
+							   return s.stream->format != HAL_PIXEL_FORMAT_BLOB;
+						   });
+			if (!yuvOnly ||
+			    it->config.size.width > largest.config.size.width ||
+			    it->config.size.height > largest.config.size.height) {
+				++it;
+				continue;
+			}
+
+			LOG(HAL, Info)
+				<< it->config.size << " will be scaled down from "
+				<< largest.config.size;
+
+			for (auto &s : it->streams) {
+				s.stream->usage |= GRALLOC_USAGE_SW_WRITE_OFTEN;
+				largest.streams.push_back({ s.stream, CameraStream::Type::Mapped });
+			}
+
+			it = streamConfigs.erase(it);
+		}
+	}
 	for (const auto &streamConfig : streamConfigs) {
 		config->addConfiguration(streamConfig.config);
 
@@ -723,7 +760,8 @@
 			 * be used when constructing the subsequent mapped
 			 * streams.
 			 */
-			if (stream.type == CameraStream::Type::Direct)
+			if (stream.type == CameraStream::Type::Direct ||
+			    stream.type == CameraStream::Type::Internal)
 				sourceStream = &streams_.back();
 		}
 	}
--- a/src/android/camera_stream.cpp
+++ b/src/android/camera_stream.cpp
@@ -182,9 +182,18 @@
 		streamBuffer->fence.reset();
 	}
 
+	/*
+	 * A YUV stream may be scaled down from its source stream: describe the
+	 * destination buffer with the size of the Android stream. JPEG goes to
+	 * a blob buffer, which keeps being described by the source.
+	 */
 	const StreamConfiguration &output = configuration();
+	Size dstSize = output.size;
+	if (camera3Stream_->format != HAL_PIXEL_FORMAT_BLOB)
+		dstSize = Size(camera3Stream_->width, camera3Stream_->height);
+
 	streamBuffer->dstBuffer = std::make_unique<CameraBuffer>(
-		*streamBuffer->camera3Buffer, output.pixelFormat, output.size,
+		*streamBuffer->camera3Buffer, output.pixelFormat, dstSize,
 		PROT_READ | PROT_WRITE);
 	if (!streamBuffer->dstBuffer->isValid()) {
 		LOG(HAL, Error) << "Failed to create destination buffer";
--- a/src/android/mm/generic_frame_buffer_allocator.cpp
+++ b/src/android/mm/generic_frame_buffer_allocator.cpp
@@ -2,22 +2,21 @@
