+/*
+ * minigbm (cros_gralloc) describes the planes in the buffer handle: after the
+ * file descriptors (an array of 5, of 4 in older versions) come the strides,
+ * the offsets and the sizes of up to 4 planes, further down a magic number and
+ * the number of planes. Use that when the handle is one of minigbm and has the
+ * number of planes of the format (a blob buffer has one): its layout is not
+ * the contiguous one assumed otherwise, for example for the msm driver
+ * (stride aligned to 128, lines of the Y plane to 32).
+ */
+bool CameraBuffer::Private::crosGrallocLayout(buffer_handle_t camera3Buffer)
+{
+	constexpr uint32_t kMagic = 0xabcddcba;
+	constexpr unsigned int kMaxPlanes = 4;
+	const unsigned int numData = camera3Buffer->numFds + camera3Buffer->numInts;
+
+	for (unsigned int maxFds : { kMaxPlanes + 1, kMaxPlanes }) {
+		const unsigned int magicIndex = maxFds + 3 * kMaxPlanes + 9;
+		const unsigned int numPlanesIndex = magicIndex + 5;
+
+		if (numData <= numPlanesIndex ||
+		    static_cast<uint32_t>(camera3Buffer->data[magicIndex]) != kMagic)
+			continue;
+
+		if (static_cast<uint32_t>(camera3Buffer->data[numPlanesIndex]) != planeInfo_.size())
+			return false;
+
+		const int *strides = &camera3Buffer->data[maxFds];
+		const int *offsets = strides + kMaxPlanes;
+		const int *sizes = offsets + kMaxPlanes;
+
+		for (unsigned int i = 0; i < planeInfo_.size(); ++i) {
+			if (bufferLength_ < static_cast<off_t>(offsets[i]) + sizes[i])
+				return false;
+
+			planeInfo_[i].stride = strides[i];
+			planeInfo_[i].offset = offsets[i];
+			planeInfo_[i].size = sizes[i];
+		}
+
+		return true;
+	}
+
+	return false;
+}
+
 unsigned int CameraBuffer::Private::numPlanes() const
 {
 	return planeInfo_.size();
