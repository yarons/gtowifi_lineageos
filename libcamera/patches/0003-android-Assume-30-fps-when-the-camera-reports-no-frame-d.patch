From: Yaron Shahrabani <yarons@users.noreply.github.com>
Subject: [PATCH] android: Assume 30 fps when the camera reports no frame durations

The simple pipeline handler with the software ISP has no
FrameDurationLimits control; the HAL refused such cameras with "Camera does
not report frame durations".
---
--- a/src/android/camera_capabilities.cpp
+++ b/src/android/camera_capabilities.cpp
@@ -660,14 +660,21 @@
 			const ControlInfoMap &controls = camera_->controls();
 			const auto frameDurations = controls.find(
 				&controls::FrameDurationLimits);
-			if (frameDurations == controls.end()) {
-				LOG(HAL, Error)
-					<< "Camera does not report frame durations";
-				return -EINVAL;
+			/*
+			 * Pipeline handlers without an ISP driver (the simple
+			 * pipeline handler with the software ISP) do not
+			 * report frame durations. Assume a fixed 30 frames per
+			 * second instead of refusing the camera.
+			 */
+			int64_t minFrameDuration = 33333333;
+			int64_t maxFrameDuration = 33333333;
+			if (frameDurations != controls.end()) {
+				minFrameDuration = frameDurations->second.min().get<int64_t>() * 1000;
+				maxFrameDuration = frameDurations->second.max().get<int64_t>() * 1000;
+			} else {
+				LOG(HAL, Warning)
+					<< "Camera does not report frame durations, assuming 30 fps";
 			}
-
-			int64_t minFrameDuration = frameDurations->second.min().get<int64_t>() * 1000;
-			int64_t maxFrameDuration = frameDurations->second.max().get<int64_t>() * 1000;
 
 			/*
 			 * Cap min frame duration to 30 FPS with 1% tolerance.
