From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yaron Shahrabani <yarons@users.noreply.github.com>
Date: Wed, 30 Sep 2026 14:13:55 +0300
Subject: [PATCH] ashmem: Relabel memfds allocated via libcutils

Backport of AOSP system/core bc5465980cc6 by Isaac J. Manjarres
("ashmem: Relabel memfds allocated via libcutils"), reverted in AOSP the
same day (0e78ca50b705) and never relanded.

On a kernel without the ashmem driver libcutils allocates memfds, which
keep the tmpfs label of the process that created them, so sharing them
needs one policy rule per pair of processes. The policy of this release
already has the other half: the ashmem_compat_memfd type, which every
domain may use like ashmem, the relabel rules and
/system/etc/selinux/ashmem_compat_memfd_context.txt. Relabel every memfd
libcutils creates to that context.

Unlike the AOSP change a failed relabel is not fatal: the memfd keeps its
tmpfs label as before and the failure is logged once. There is no ashmem
driver to fall back to, so failing the allocation would break every
process that cannot read the context file.
---
 libcutils/ashmem-dev.cpp | 70 ++++++++++++++++++++++++++++++++++++----
 1 file changed, 63 insertions(+), 7 deletions(-)

diff --git a/libcutils/ashmem-dev.cpp b/libcutils/ashmem-dev.cpp
index 0874655..045dc00 100644
--- a/libcutils/ashmem-dev.cpp
+++ b/libcutils/ashmem-dev.cpp
@@ -29,6 +29,7 @@
 #include <sys/syscall.h>
 #include <sys/sysmacros.h>
 #include <sys/types.h>
+#include <sys/xattr.h>
 #include <unistd.h>
 
 #include <android-base/file.h>
@@ -55,6 +56,66 @@ static std::atomic<dev_t> __ashmem_rdev;
 /* set to true for verbose logging and other debug  */
 static bool debug_log = false;
 
+static bool assign_ashmem_label_to_memfd(android::base::unique_fd& fd) {
+    static const std::string context = []() -> std::string {
+        // The security context comes from a file that is part of the security policy. Hardcoding
+        // this information would cause a layering violation, since the code should not decide
+        // what context it should be using, but rather that decision should be up to the policy.
+        const std::string context_path = "/system/etc/selinux/ashmem_compat_memfd_context.txt";
+        std::string context;
+
+        if (!android::base::ReadFileToString(context_path, &context)) {
+            ALOGE("Failed to read %s: %m", context_path.c_str());
+            return "";
+        }
+
+        context = android::base::Trim(context);
+        if (context.empty()) {
+            ALOGE("Ashmem SELinux label file is empty");
+            return "";
+        }
+        return context;
+    }();
+    if (context.empty()) {
+        return false;
+    }
+
+    if (fsetxattr(fd, XATTR_NAME_SELINUX, context.c_str(), context.size() + 1, 0) < 0) {
+        static std::atomic<bool> logged;
+        if (!logged.exchange(true)) {
+            ALOGE("fsetxattr(%s) failed: %m", context.c_str());
+        }
+        return false;
+    }
+
+    return true;
+}
+
+/* Allocates a memfd and assigns a security context that is provided by the system's security
+ * policy.
+ *
+ * Unlike AOSP's change (reverted there), a failed relabel is not fatal: the memfd keeps its tmpfs
+ * label, as it did before. Without an ashmem driver there is nothing to fall back to, so failing
+ * here would break every allocation of a process that cannot read the context file (recovery, early
+ * boot, a domain without access).
+ */
+static android::base::unique_fd __memfd_create_region(const char* name) {
+    // This code needs to build on API levels before 30,
+    // so we can't use the libc wrapper.
+    android::base::unique_fd fd(syscall(__NR_memfd_create, name, MFD_CLOEXEC | MFD_ALLOW_SEALING));
+    if (fd == -1) {
+        return android::base::unique_fd{-1};
+    }
+
+    // memfds are initially labeled as tmpfs files by SELinux. Unfortunately, this makes having
+    // per-domain memfd types and writing scalable policy targeted towards memfd specifically
+    // difficult. Therefore, we relabel memfds allocated by libcutils with a label that the
+    // policy has defined to allow the necessary access to memfds.
+    assign_ashmem_label_to_memfd(fd);
+
+    return fd;
+}
+
 /* Determine if memfd can be supported. This is just one-time hardwork
  * which will be cached by the caller.
  */
@@ -71,10 +132,7 @@ static bool __has_memfd_support() {
     }
 
     // Check that the kernel supports memfd_create().
-    // This code needs to build on API levels before 30,
-    // so we can't use the libc wrapper.
-    android::base::unique_fd fd(
-            syscall(__NR_memfd_create, "test_android_memfd", MFD_CLOEXEC | MFD_ALLOW_SEALING));
+    android::base::unique_fd fd = __memfd_create_region("test_android_memfd");
     if (fd == -1) {
         ALOGE("memfd_create() failed: %m, no memfd support");
         return false;
@@ -234,9 +292,7 @@ int ashmem_valid(int fd) {
 }
 
 static int memfd_create_region(const char* name, size_t size) {
-    // This code needs to build on API levels before 30,
-    // so we can't use the libc wrapper.
-    android::base::unique_fd fd(syscall(__NR_memfd_create, name, MFD_CLOEXEC | MFD_ALLOW_SEALING));
+    android::base::unique_fd fd = __memfd_create_region(name);
 
     if (fd == -1) {
         ALOGE("memfd_create(%s, %zd) failed: %m", name, size);
-- 
