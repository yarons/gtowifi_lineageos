prebuilt_etc {
    name: "fstab.gtowifi",
    src: "fstab.gtowifi",
    vendor: true,
    ramdisk_available: true,
}

// Same installed name; device.mk picks one of the two
prebuilt_etc {
    name: "fstab.gtowifi.sdcard",
    src: "fstab.gtowifi.sdcard",
    filename: "fstab.gtowifi",
    vendor: true,
    ramdisk_available: true,
}
