prebuilt_etc {
    name: "fstab.gtowifi",
    src: "fstab.gtowifi",
    vendor: true,
    ramdisk_available: true,
}

// Development layout with every Android partition on the microSD card. Both files are always
// installed; first-stage init takes this one when the kernel command line carries
// androidboot.fstab_suffix=gtowifi_sdcard (BoardConfig.mk, GTOWIFI_MAINLINE_SYSTEM_ON_SDCARD).
prebuilt_etc {
    name: "fstab.gtowifi_sdcard",
    src: "fstab.gtowifi_sdcard",
    vendor: true,
    ramdisk_available: true,
}
