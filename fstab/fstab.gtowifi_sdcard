# Development layout (androidboot.fstab_suffix=gtowifi_sdcard, set by
# GTOWIFI_MAINLINE_SYSTEM_ON_SDCARD := true): every Android partition is a
# GPT partition on the microSD card, the kernel is started with `fastboot boot` from lk2nd.
# Nothing on the eMMC is written, so the installed OS keeps working.
#
# androidboot.boot_devices points at the SD controller, so /dev/block/by-name/ is the card.
# eMMC partitions are reached through /dev/block/platform/soc@0/7824900.mmc/by-name/.
#
# GPT partition names expected on the card (tools/partition-sdcard.sh):
#   system vendor vendor_dlkm metadata cache userdata

# Cache
/dev/block/by-name/cache /cache ext4 nodev,noatime,nosuid,discard check,formattable

# Firmware (eMMC, read-only)
/dev/block/platform/soc@0/7824900.mmc/by-name/apnhlos /vendor/firmware_mnt vfat ro,context=u:object_r:firmware_mnt_file:s0,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 defaults

# Metadata
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum

# Persist (eMMC, read-only)
/dev/block/platform/soc@0/7824900.mmc/by-name/persist /mnt/vendor/persist ext4 nosuid,nodev,noatime,ro defaults

# System
/dev/block/by-name/system /system erofs noatime,ro first_stage_mount
/dev/block/by-name/system /system ext4 noatime,ro first_stage_mount

# USB
/devices/platform/soc@0/78db000.usb/*/usb* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# Userdata
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard latemount,check,quota,formattable
/dev/block/by-name/userdata /data f2fs nodev,noatime,nosuid,discard,reserve_root=32768 latemount,check,quota,formattable

# Vendor
/dev/block/by-name/vendor /vendor ext4 noatime,ro first_stage_mount

# Vendor DLKM
/dev/block/by-name/vendor_dlkm /vendor_dlkm ext4 noatime,ro first_stage_mount

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
