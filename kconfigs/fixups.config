# On top of the postmarketOS msm89x7 config + the kernel/mainline/configs fragments.
# Checked with kernel-config/resolve-stack.sh: 248 of 260 Android 16 base requirements, the
# rest is clang-only or Android-common-kernel-only.

# PMI632/PM8953 thermal zones in sdm429-samsung-gtowifi.dts
CONFIG_QCOM_SPMI_ADC_TM5=y

# Speaker amplifiers (kernel branch gtowifi/integration); every other audio and sensor symbol is
# already =m in the postmarketOS config
CONFIG_SND_SOC_AW87319=m

# Display and GPU (kernel branch gtowifi/display-v2): the SDM429 DSI PHY is the 12nm one, the panel is an
# ILI9881C behind it; DRM_MSM itself is already =m in the postmarketOS config
CONFIG_DRM_MSM_DSI_12NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_GTOWIFI_ILI9881C_LD=m
# MDP5, not DPU: with both built, msm picks DPU for qcom,msm8937-mdp5 (prefer_mdp5 defaults to off).
# DPU on this SoC never gets a vblank interrupt here (944 "vblank timeout" in 3 minutes, 34 ms median
# frame time); the display bring-up was done and verified on MDP5 (0 timeouts, 23 ms).
# CONFIG_DRM_MSM_DPU is not set

# Cameras (kernel branch gtowifi/android-next): GalaxyCore GC8034 (rear) and GC2375H (front) behind the
# SDM439 flavour of CAMSS with the Synopsys CSIPHY; CAMSS, CCI and the media core are already =m
CONFIG_VIDEO_GC8034=m
CONFIG_VIDEO_GC2375H=m
# Lens of the rear camera
CONFIG_VIDEO_GT9772=m

# Backlight (kernel branch gtowifi/backlight): pwm-backlight on the PM8953 PWM (leds-qcom-lpg). The
# panel driver waits for the backlight device, so keep the whole chain built in instead of relying
# on module load order (BACKLIGHT_PWM and PWM are already =y)
# (LEDS_QCOM_LPG can only be built in when QCOM_PBS is not a module)
CONFIG_QCOM_PBS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y

# Module signing off. The pmOS config signs every module at modules_install (MODULE_SIG_ALL). Inside
# the Android build scripts/sign-file is linked against BoringSSL, whose partial CMS API makes it
# take the CMS path and fail ("cms.cc: function should not have been called"). Nothing in Android
# wants signed modules on a device-specific kernel. The lockdown LSM selects MODULE_SIG, so it goes
# too; Android does not use it.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_SIG is not set

# Hang detection. The tablet froze once without a trace (2026-09-21, kernel r11: adb enumerated, no
# command returned). With these a task stuck in D state for a minute, or a CPU that stops scheduling,
# prints its stack to the console, which ramoops keeps across the forced restart
# (lk2nd: fastboot oem ramoops console, fastboot get_staged).
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_SOFTLOCKUP_DETECTOR=y

# USB host mode (OTG adapter), kernel export r13: micro-USB ID detection of the PMI632 and its VBUS
# boost regulator. Built in: as modules they would load after ci_hdrc has probed, USB would defer
# and adb would be gone. USB sticks: usb-storage built in as well (it was a module nobody loaded).
CONFIG_EXTCON_QCOM_PMIC_UUSB=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_USB_STORAGE=y

# Suspend test builds (kernel r14 and later): the kernel's own account of a suspend. PM_SLEEP_DEBUG adds
# /sys/power/pm_debug_messages (which device or step blocks a suspend) and pm_wakeup_irq (what woke it);
# RPM master stats show whether the application processor and the rest of the SoC really powered down
# (the RPM counts their shutdowns), which is the difference between s2idle saving power or not.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_QCOM_RPM_MASTER_STATS=y
