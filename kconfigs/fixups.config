# On top of the postmarketOS msm89x7 config + the kernel/mainline/configs fragments.
# Checked with kernel-config/resolve-stack.sh: 248 of 260 Android 16 base requirements, the
# rest is clang-only or Android-common-kernel-only.

# PMI632/PM8953 thermal zones in sdm429-samsung-gtowifi.dts
CONFIG_QCOM_SPMI_ADC_TM5=y

# Speaker amplifiers (kernel branch gtowifi/integration); every other audio and sensor symbol is
# already =m in the postmarketOS config
CONFIG_SND_SOC_AW87319=m

# Display and GPU (kernel branch gtowifi/display-v2): the SDM429 DSI PHY is the 12nm one, the panel is an
# ILI9881C behind it; DRM_MSM itself is already =m in the postmarketOS config
CONFIG_DRM_MSM_DSI_12NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_GTOWIFI_ILI9881C_LD=m

# Module signing off. The pmOS config signs every module at modules_install (MODULE_SIG_ALL). Inside
# the Android build scripts/sign-file is linked against BoringSSL, whose partial CMS API makes it
# take the CMS path and fail ("cms.cc: function should not have been called"). Nothing in Android
# wants signed modules on a device-specific kernel. The lockdown LSM selects MODULE_SIG, so it goes
# too; Android does not use it.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_SIG is not set
