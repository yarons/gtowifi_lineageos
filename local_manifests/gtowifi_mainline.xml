<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to .repo/local_manifests/ of a lineage-23.2 checkout, together with
  gtowifi_mainline_deps.xml next to this file (device/mainline/*, external/lk2nd,
  kernel/mainline/configs, ...): roomservice cannot resolve the dependencies of a device tree that
  is not in the LineageOS organisation.
-->
<manifest>
  <remote name="yarons" fetch="https://github.com/yarons" />
  <remote name="glodroid" fetch="https://github.com/GloDroid" />
  <remote name="libcamera-org" fetch="https://github.com/libcamera-org" />

  <project path="device/samsung/gtowifi_mainline" name="gtowifi_lineageos" remote="yarons" revision="lineage-23.2" />

  <!-- msm89x7-mainline 7.1.3 + the gtowifi board work + the ANDROID patches (README.md, "Kernel") -->
  <project path="kernel/mainline/msm89x7-mainline" name="linux_msm89x7" remote="yarons" revision="gtowifi/android-7.1.3-r12" clone-depth="1" />

  <!-- Cameras: upstream libcamera, cross-compiled with meson through aospext (libcamera/Android.mk);
       the patches in libcamera/patches/ are applied to a copy at build time. Both are pinned to what
       the tree was built and tested with. -->
  <project path="external/libcamera-upstream" name="libcamera" remote="libcamera-org" revision="refs/tags/v0.7.2" />
  <project path="vendor/aospext" name="aospext" remote="glodroid" revision="8c3075ffb6005b1c317e69d4da4071dc2403e0f9" />
</manifest>
