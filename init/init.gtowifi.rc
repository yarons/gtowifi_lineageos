import /vendor/etc/init/hw/init.mainline.qcom.rc

# Mount
on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

# Display
# Hand the framebuffer over from fbcon once the UI is up
on property:sys.bootstat.first_boot_completed=1
    write /sys/class/vtconsole/vtcon0/bind 0
    write /sys/class/vtconsole/vtcon1/bind 0

# Kernel module loading
# wcnss/adsp probe before /vendor/firmware_mnt exists and do not retry, so they are started
# again once the firmware partition is mounted
on post-fs
    # Firmware of the modem DSP (mba.mbn, modem.mdt, modem.bNN), see "GNSS" below
    mkdir /mnt/vendor/modem_firmware 0555 root root
    mount vfat /dev/block/by-name/modem /mnt/vendor/modem_firmware ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_mnt_file:s0

    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal
    trigger start_all_remoteproc

# GNSS
# This Wi-Fi model has a modem DSP too: it runs the location engine, which the GNSS HAL reaches
# with QMI over QRTR. The modem wants its remote file system first. The stack's rmtfs service
# serves the EFS partitions read-only (-r: what the modem writes stays in memory, the eMMC is never
# written) and starts and stops the modem itself (-s), which is why start_all_remoteproc has to
# leave it alone (vendor.remoteproc.4080000_remoteproc.ignore). Kernels without the modem in
# their device tree have no such remoteproc: nothing is started then.
on boot
    start vendor.gtowifi-modem

# Switched at run time; rmtfs stops the modem when it exits (it was started with -s)
on property:sys.boot_completed=1 && property:persist.vendor.gtowifi.gnss=1
    start vendor.gtowifi-modem

on property:persist.vendor.gtowifi.gnss=0
    stop vendor.rmtfs

service vendor.gtowifi-modem /vendor/bin/sh /vendor/bin/init.gtowifi.modem.sh
    user root
    group root system
    oneshot
    disabled

# Sensors
# The accelerometer and proximity sensor are IIO devices of the ADSP's sensor manager; they appear a
# few seconds after the ADSP has started, which is after the sensors HAL has enumerated /sys/bus/iio
# (it does that once, when it starts). Start it again as soon as the accelerometer driver is bound.
on property:vendor.remoteproc.adsp.is_started=1
    wait /sys/bus/platform/drivers/qcom_smgr_accel/qcom-smgr-accel.0 10
    restart vendor.sensors-hal-multihal

# ZRAM
# Not through the fstab and swapon_all (the stack's zram.rc): fs_mgr opens
# /sys/block/zram0/max_comp_streams unconditionally, current kernels do not have it any more and
# swapon_all fails ("Unable to open zram conf comp device"), which left the tablet without swap.
on property:persist.sys.zram_enabled=1
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/disksize 1073741824
    write /proc/sys/vm/page-cluster 0
    exec - root root -- /system/bin/mkswap /dev/block/zram0
    exec - root root -- /system/bin/swapon /dev/block/zram0
