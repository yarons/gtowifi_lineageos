# Firmware comes from the tablet's own apnhlos partition; nothing proprietary is in the build
firmware_directories /vendor/firmware_mnt/image/ /odm/firmware/

modalias_handling enabled

# Sensors: the sensors HAL (user system) streams from the IIO devices of the ADSP's sensor manager
# (qcom_smgr). The kernel creates them root-only.
/dev/iio:device*    0660   system   system
/sys/bus/iio/devices/iio:device*    buffer/enable                       0660   system   system
/sys/bus/iio/devices/iio:device*    buffer/length                       0660   system   system
/sys/bus/iio/devices/iio:device*    scan_elements/in_accel_x_en         0660   system   system
/sys/bus/iio/devices/iio:device*    scan_elements/in_accel_y_en         0660   system   system
/sys/bus/iio/devices/iio:device*    scan_elements/in_accel_z_en         0660   system   system
/sys/bus/iio/devices/iio:device*    scan_elements/in_proximity_en       0660   system   system
/sys/bus/iio/devices/iio:device*    scan_elements/in_timestamp_en       0660   system   system
/sys/bus/iio/devices/iio:device*    in_accel_sampling_frequency         0660   system   system
/sys/bus/iio/devices/iio:device*    in_proximity_sampling_frequency     0660   system   system

# Cameras: media controller graph of CAMSS (sensor -> csiphy -> csid -> ispif -> vfe), used by libcamera
/dev/media*         0660   system   camera
/dev/video*         0660   system   camera
/dev/v4l-subdev*    0660   system   camera
