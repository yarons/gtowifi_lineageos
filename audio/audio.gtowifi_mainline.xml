<!--
    tinyhal configuration for the Samsung Galaxy Tab A 8.0 2019 (sound card "samsung-gtowifi").

    PM8953 codec (msm8916-wcd analog + digital) behind the ADSP. There is no earpiece and no lineout:
    both speakers hang off the HEADPHONE outputs through two AW87319 amplifiers, so "speaker" and
    "headphone" are the same codec route and differ only in the two pin switches of the sound card.
    Routes and levels as tried on hardware with amixer under postmarketOS (speakers and built-in
    microphone heard/recorded; headphone jack, headset microphone and jack detection not tried).
-->
<audiohal>
    <mixer card="0">
        <init>
            <!-- Speakers and headphones: 84 = 0 dB, 1 dB steps. Tried on hardware at 64 only. -->
            <ctl name="RX1 Digital Volume" val="80"/>
            <ctl name="RX2 Digital Volume" val="80"/>
            <!-- Built-in microphone, 6 dB steps: 4 was too quiet for speech at arm's length -->
            <ctl name="ADC1 Volume" val="7"/>
            <!-- Headset microphone -->
            <ctl name="ADC2 Volume" val="7"/>
            <ctl name="TX1 Digital Volume" val="84"/>
            <ctl name="Speaker Switch" val="0"/>
            <ctl name="Headphones Switch" val="0"/>
        </init>
    </mixer>
    <device name="speaker">
        <path name="on">
            <ctl name="RX1 MIX1 INP1" val="RX1"/>
            <ctl name="RX2 MIX1 INP1" val="RX2"/>
            <ctl name="RDAC2 MUX" val="RX2"/>
            <ctl name="HPHL" val="Switch"/>
            <ctl name="HPHR" val="Switch"/>
            <ctl name="Headphones Switch" val="0"/>
            <ctl name="Speaker Switch" val="1"/>
        </path>
        <path name="off">
            <ctl name="Speaker Switch" val="0"/>
            <ctl name="HPHL" val="ZERO"/>
            <ctl name="HPHR" val="ZERO"/>
            <ctl name="RX1 MIX1 INP1" val="ZERO"/>
            <ctl name="RX2 MIX1 INP1" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <!-- No earpiece on a tablet: the policy of the SoC family still lists one, send it to the speakers -->
    <device name="earpiece">
        <path name="on">
            <ctl name="RX1 MIX1 INP1" val="RX1"/>
            <ctl name="RX2 MIX1 INP1" val="RX2"/>
            <ctl name="RDAC2 MUX" val="RX2"/>
            <ctl name="HPHL" val="Switch"/>
            <ctl name="HPHR" val="Switch"/>
            <ctl name="Headphones Switch" val="0"/>
            <ctl name="Speaker Switch" val="1"/>
        </path>
        <path name="off">
            <ctl name="Speaker Switch" val="0"/>
            <ctl name="HPHL" val="ZERO"/>
            <ctl name="HPHR" val="ZERO"/>
            <ctl name="RX1 MIX1 INP1" val="ZERO"/>
            <ctl name="RX2 MIX1 INP1" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <device name="headphone">
        <path name="on">
            <ctl name="RX1 MIX1 INP1" val="RX1"/>
            <ctl name="RX2 MIX1 INP1" val="RX2"/>
            <ctl name="RDAC2 MUX" val="RX2"/>
            <ctl name="HPHL" val="Switch"/>
            <ctl name="HPHR" val="Switch"/>
            <ctl name="Speaker Switch" val="0"/>
            <ctl name="Headphones Switch" val="1"/>
        </path>
        <path name="off">
            <ctl name="Headphones Switch" val="0"/>
            <ctl name="HPHL" val="ZERO"/>
            <ctl name="HPHR" val="ZERO"/>
            <ctl name="RX1 MIX1 INP1" val="ZERO"/>
            <ctl name="RX2 MIX1 INP1" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <device name="headset">
        <path name="on">
            <ctl name="RX1 MIX1 INP1" val="RX1"/>
            <ctl name="RX2 MIX1 INP1" val="RX2"/>
            <ctl name="RDAC2 MUX" val="RX2"/>
            <ctl name="HPHL" val="Switch"/>
            <ctl name="HPHR" val="Switch"/>
            <ctl name="Speaker Switch" val="0"/>
            <ctl name="Headphones Switch" val="1"/>
        </path>
        <path name="off">
            <ctl name="Headphones Switch" val="0"/>
            <ctl name="HPHL" val="ZERO"/>
            <ctl name="HPHR" val="ZERO"/>
            <ctl name="RX1 MIX1 INP1" val="ZERO"/>
            <ctl name="RX2 MIX1 INP1" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
    </device>
    <device name="mic">
        <path name="on">
            <ctl name="DEC1 MUX" val="ADC1"/>
            <ctl name="CIC1 MUX" val="AMIC"/>
        </path>
        <path name="off">
            <ctl name="DEC1 MUX" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="0"/>
        </path>
    </device>
    <!-- One built-in microphone: the policy's back microphone is the same one -->
    <device name="back mic">
        <path name="on">
            <ctl name="DEC1 MUX" val="ADC1"/>
            <ctl name="CIC1 MUX" val="AMIC"/>
        </path>
        <path name="off">
            <ctl name="DEC1 MUX" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="0"/>
        </path>
    </device>
    <device name="headset_in">
        <path name="on">
            <ctl name="DEC1 MUX" val="ADC2"/>
            <ctl name="CIC1 MUX" val="AMIC"/>
            <ctl name="ADC2 MUX" val="INP2"/>
        </path>
        <path name="off">
            <ctl name="ADC2 MUX" val="ZERO"/>
            <ctl name="DEC1 MUX" val="ZERO"/>
        </path>
        <path name="pcm_on">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="1"/>
        </path>
        <path name="pcm_off">
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="0"/>
        </path>
    </device>
    <stream type="pcm" dir="out" card="0" device="0">
        <enable path="pcm_on"/>
        <disable path="pcm_off"/>
    </stream>
    <stream type="pcm" dir="in" card="0" device="1">
        <enable path="pcm_on"/>
        <disable path="pcm_off"/>
    </stream>
</audiohal>
