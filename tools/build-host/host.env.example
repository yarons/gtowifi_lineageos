# One file per build host, sourced before start-build.sh:  . my-host.env; ./start-build.sh
# The default, and the tested host: a laptop with 16 GB RAM prepared by setup-arch-host.sh (zram + disk
# swap, no container memory cap, 4 jobs, kept awake while the build runs). Only HOST is required; the
# rest shows start-build.sh's defaults.
export HOST=user@laptop
# export BASE=/home/user/lineage     # default: ~/lineage on the host
# export REQUIRE_MOUNT=0
# export MEM=none
# export BUILD_JOBS=4
# export INHIBIT=1
# A machine that builds comfortably (64 GB RAM, a disk mounted for the tree, shared with other work):
# export HOST=user@build-host
# export BASE=/mnt/lineage
# export REQUIRE_MOUNT=1
# export MEM=96g
# export BUILD_JOBS=
# export INHIBIT=0
