# One file per build host, sourced before start-build.sh:  . my-host.env; ./start-build.sh
# A machine that builds comfortably (64 GB RAM, a disk mounted for the tree):
export HOST=user@build-host
export BASE=/mnt/lineage
export REQUIRE_MOUNT=1
export MEM=96g
export BUILD_JOBS=
export INHIBIT=0
# A laptop with 16 GB RAM prepared by setup-arch-host.sh (zram, no container memory cap, few jobs,
# kept awake while the build runs):
# export HOST=user@laptop
# export BASE=/home/user/lineage
# export REQUIRE_MOUNT=0
# export MEM=none
# export BUILD_JOBS=4
# export INHIBIT=1
